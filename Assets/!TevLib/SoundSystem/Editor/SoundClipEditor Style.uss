.section-title {
    background-color: dodgerblue;
    color : white;
    -unity-font-style: bold;
    font-size: 18px;
    margin-bottom: 4px;
}

.waveform-slot {
    margin-top: 10px;
    height: 80px;
}

.time-label {
    -unity-font-style: bold;
    width: 120px;
}

.time-row {
    flex-direction: row;
}

.play-btn {
    width: 100px;
    height: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-color: rgb(34, 102, 151);
}
