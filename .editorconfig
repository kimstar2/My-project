root = true

[*.cs]
# Keep architecture-related warnings visible without turning style preferences
# into build failures.
dotnet_diagnostic.CA1501.severity = suggestion
dotnet_diagnostic.CA1502.severity = suggestion
dotnet_diagnostic.CA1505.severity = suggestion
dotnet_diagnostic.CA1506.severity = suggestion
dotnet_diagnostic.IDE0051.severity = suggestion
dotnet_diagnostic.IDE0052.severity = suggestion
dotnet_diagnostic.IDE0060.severity = suggestion

# Rider/ReSharper solution-wide inspections.
resharper_unused_member_global_highlighting = suggestion
resharper_unused_type_global_highlighting = suggestion
resharper_unused_parameter_local_highlighting = suggestion
resharper_member_can_be_private_global_highlighting = suggestion
resharper_convert_to_auto_property_highlighting = suggestion
resharper_inconsistent_naming_highlighting = suggestion

[Assets/Controls.cs]
generated_code = true

[Assets/InputSystem_Actions.cs]
generated_code = true
